<Project>
  <!-- See https://aka.ms/dotnet/msbuild/customize for more details on customizing your build -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net462;net8.0;net10.0</TargetFrameworks>
    <Version>2.0.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <Title>.NET Configuration Extensions for AWS S3</Title>
    <Description>.NET Configuration Extensions for loading configuration files from AWS S3.</Description>
    <PackageTags>AWS;Amazon;aws-sdk-v3;S3;configuration</PackageTags>
    <Company>Milestone Technology Group, LLC.</Company>
    <Authors>jpenniman</Authors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageProjectUrl>https://github.com/milestonetg/extensions-configuration-s3</PackageProjectUrl>
  </PropertyGroup>
</Project>
